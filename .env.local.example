# ============================================================================
# Khan Farms — environment variables. Copy to `.env.local` and fill in.
# NEVER commit real secrets. `.env*.local` is gitignored.
# ============================================================================

# --- Sanity CMS ---
# Get these from https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=r82ngztn
NEXT_PUBLIC_SANITY_DATASET=production
# NOTE: rotate this token in Sanity — the previous value was committed to git.
SANITY_API_TOKEN=your_sanity_api_token
# Optional: webhook-based revalidation
REVALIDATE_SECRET=your_random_secret_string_here

# --- Database (Postgres / Neon) ---
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct (non-pooled) connection used by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- NextAuth / Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=your_generated_secret
# Local dev URL (in prod set to https://kfarms.ng)
NEXTAUTH_URL=http://localhost:3000

# --- Google OAuth ---
# From https://console.cloud.google.com — Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- Email (Resend) — magic links + admin notifications ---
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM="Khan Farms <no-reply@kfarms.ng>"
# Where new-enquiry notifications are sent (defaults to info@khan.ng).
ENQUIRY_NOTIFY_EMAIL=info@khan.ng

# --- Admin bootstrap ---
# Run `npm run db:seed` to promote this email to ADMIN (after they register).
ADMIN_EMAIL=you@example.com

# --- Phase 2: Phone / WhatsApp OTP (Termii) — not required for Phase 1 ---
# TERMII_API_KEY=your_termii_api_key
# TERMII_SENDER_ID=your_sender_id
